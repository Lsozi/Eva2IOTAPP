<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomenu1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".ManipularESP32">

    <TextView
        android:id="@+id/tvusumanipular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/design_default_color_primary_variant"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Bienvenido(a) : "
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvtitman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Control de Alarma ESP32"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnoff"
        android:layout_width="340dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:text="APAGAR ALARMA"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnvolman"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@android:color/holo_purple"
        android:text="Volver"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>